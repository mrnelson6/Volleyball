# On-demand Volleyball match-server spawner.
# Install (as the user that owns ~/volleyball):
#   mkdir -p ~/.config/systemd/user
#   cp volleyball-spawn.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now volleyball-spawn
#   loginctl enable-linger $USER        # keep it running after logout
# Logs: journalctl --user -u volleyball-spawn -f

[Unit]
Description=Volleyball on-demand match-server spawner
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 %h/volleyball/vb-spawn.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
